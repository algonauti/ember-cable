{
  "name": "test-app",
  "version": "1.4.0",
  "description": "Power your ember.js application with actioncable",
  "keywords": [
    "ember-cli",
    "ember",
    "node",
    "realtime",
    "websocket",
    "actioncable",
    "rails"
  ],
  "homepage": "https://github.com/algonauti/ember-cable",
  "license": "MIT",
  "author": "Salvatore Ferrucci",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algonauti/ember-cable.git"
  },
  "bugs": {
    "url": "https://github.com/algonauti/ember-cable/issues"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "ember test",
    "test:ember": "ember test",
    "test:try": "ember try:each"
  },
  "devDependencies": {
    "@algonauti/ember-cable": "workspace:*",
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/macros": "^1.21.3",
    "@embroider/test-setup": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@ijlee2-frontend-configs/ember-template-lint": "^3.0.2",
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.7.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.2",
    "@ijlee2-frontend-configs/stylelint": "^3.3.1",
    "@rails/actioncable": "^8.1.400",
    "broccoli-asset-rev": "^3.0.0",
    "concurrently": "^10.0.6",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.3.0",
    "ember-cli-app-version": "^7.0.0",
    "ember-cli-babel": "^8.3.2",
    "ember-cli-clean-css": "^3.0.0",
    "ember-cli-dependency-checker": "^3.4.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-mirage": "^3.0.4",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-imports": "^4.4.0",
    "ember-template-lint": "^7.9.4",
    "ember-try": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.13.0",
    "loader.js": "^4.7.0",
    "miragejs": "^0.1.48",
    "mock-socket": "^9.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1"
  },
  "engines": {
    "node": ">= 20.19"
  },
  "ember": {
    "edition": "octane"
  },
  "private": true
}
